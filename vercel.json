{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/index-v2.html", "destination": "/", "permanent": true },
    { "source": "/email-v2", "destination": "/email/", "permanent": true },
    { "source": "/email-v2/", "destination": "/email/", "permanent": true },
    { "source": "/email-v2/:path*", "destination": "/email/", "permanent": true }
  ]
}
