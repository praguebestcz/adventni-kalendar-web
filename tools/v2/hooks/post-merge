#!/bin/sh
# After merging the look work (nove-vzhledy) in, rebuild index.html and commit it if it changed.
[ -f tools/v2/build_v2.py ] || exit 0
python -I tools/v2/build_v2.py >/dev/null || { echo "build_v2.py failed, index.html not rebuilt" >&2; exit 0; }
git diff --quiet -- index.html index-old.html && exit 0
git add index.html index-old.html
git commit -q --no-verify -m "Rebuild index.html from the merged index-old.html"
